# Copy to `.env` and fill in real values (never commit `.env`).
# All vars are read through `lib/env.ts` (Zod-validated).

# This app's own Postgres. Locally / for migrations: Supabase Session pooler
# (port 5432). On Vercel: the Transaction pooler (port 6543).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/fenrir"

# Signs session cookies and exam tokens. Generate with: openssl rand -base64 48
AUTH_SECRET="replace-with-at-least-32-character-secret"

# Public origin, used for the Google redirect URI. Optional locally.
APP_URL=""

# Optional: "Sign in with Google" shows up only when both are set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend sends the sign-up and password-reset codes. Unset in development:
# the email is printed to the server console instead. EMAIL_FROM must use a
# domain verified in Resend (onboarding@resend.dev only reaches your own inbox).
RESEND_API_KEY=""
EMAIL_FROM="Fenrir <onboarding@resend.dev>"
