# Copy to `.env` and fill in real values (never commit `.env`).
# All vars are read through `lib/env.ts` (Zod-validated).

# The SAME Postgres database as the main CodeQuest app. On Vercel use the
# pooled connection string (Neon `-pooler` host / Supabase port 6543).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/codequest?schema=public"

# Shared secret for the per-exam tokens the main app issues. Must be
# IDENTICAL to ANTI_CHEAT_TOKEN_SECRET in the main app. Generate with:
#   openssl rand -base64 48
ANTI_CHEAT_TOKEN_SECRET="replace-with-at-least-32-character-secret"

# Comma-separated browser origins allowed to call the API — the main app's
# URL(s), no trailing slash. Local dev: the main app runs on port 3000.
ALLOWED_ORIGINS="http://localhost:3000"
