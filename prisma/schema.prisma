// Fenrir — standalone proctored exam app. This repo owns its database and
// every migration (`prisma/migrations`). Apply them with
// `npm run db:migrate` (prisma migrate deploy).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  fullName        String
  /// Null for accounts that only ever signed in with Google.
  passwordHash    String?
  /// Google account id (`sub`) once the user has signed in with Google.
  googleSub       String?       @unique
  /// Set when ownership of `email` is proven (Google sign-in, admin seed).
  /// Self-registered accounts stay unverified: there is no email step.
  emailVerifiedAt DateTime?
  /// LEARNER | ADMIN
  role            String        @default("LEARNER")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  sessions        ExamSession[]
}

/// Failed password sign-ins per email, to slow down password guessing.
model LoginThrottle {
  email       String    @id
  failures    Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
}

/// One-time 6-digit codes emailed for sign-up verification and password
/// reset. Only an HMAC of the code is stored.
model EmailCode {
  id        String    @id @default(cuid())
  email     String
  /// VERIFY_EMAIL | RESET_PASSWORD
  purpose   String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, purpose, createdAt])
}

/// An exam authored in the admin builder. Learners only see PUBLISHED ones.
/// Questions are copied into each `ExamSession` when it starts, so editing an
/// exam never changes an attempt that is in progress or finished.
model Exam {
  id                String        @id @default(cuid())
  title             String
  description       String        @default("")
  /// DRAFT (admins only) | PUBLISHED (learners can start) | CLOSED (results only)
  status            String        @default("DRAFT")
  durationMinutes   Int           @default(30)
  passPercent       Int           @default(60)
  shuffleQuestions  Boolean       @default(false)
  shuffleChoices    Boolean       @default(false)
  /// Only Safe Exam Browser running one of `sebConfigKeys` may start/submit.
  requireSeb        Boolean       @default(false)
  /// Config Keys (64 hex chars, from SEB Config Tool) of the accepted .seb files.
  sebConfigKeys     String[]      @default([])
  /// The .seb file learners download to open the exam in SEB (optional).
  sebConfigFile     Bytes?
  sebConfigFileName String?
  createdById       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  items             ExamItem[]
  sessions          ExamSession[]

  @@index([status, createdAt])
}

/// One multiple-choice question: 2–8 `choices`, `correctIndex` 0-based.
model ExamItem {
  id           String   @id @default(cuid())
  examId       String
  position     Int
  prompt       String
  choices      String[]
  correctIndex Int
  exam         Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId, position])
}

/// A learner's single attempt at an exam (one per learner per exam).
model ExamSession {
  id                String               @id @default(cuid())
  examId            String
  userId            String
  /// ACTIVE | SUBMITTED | TERMINATED | EXPIRED
  status            String               @default("ACTIVE")
  /// PASS | FAIL | BANNED | TERMINATED | EXPIRED — set once the attempt ends.
  outcome           String?
  /// The anti-cheat reason when status = TERMINATED (see lib/policy.ts).
  terminationReason String?
  startedAt         DateTime             @default(now())
  expiresAt         DateTime
  submittedAt       DateTime?
  passPercent       Int
  /// What the learner sees: [{ id, prompt, choices }] in session order.
  questions         Json
  /// Correct choice index per question, same order. Never sent to the browser.
  answerKey         Int[]
  /// Submitted choice index per question; -1 = left unanswered.
  answers           Int[]                @default([])
  /// Choices autosaved by the exam page while the attempt runs (-1 = none),
  /// so admins see live progress and what an attempt held when it ended.
  draftAnswers      Int[]                @default([])
  /// Last request from the exam page (an answer or the heartbeat).
  lastSeenAt        DateTime?
  correctCount      Int?
  scorePercent      Int?
  passed            Boolean?
  updatedAt         DateTime             @updatedAt
  exam              Exam                 @relation(fields: [examId], references: [id], onDelete: Cascade)
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  events            ExamIntegrityEvent[]
  activities        ExamActivity[]

  @@unique([examId, userId])
  @@index([userId])
  @@index([status])
}

/// The admin's detailed log of one attempt: start and resume (with IP and
/// device), every answer change, connection drops, submit and the end.
/// Anti-cheat signals stay in `ExamIntegrityEvent`; the admin log merges both.
model ExamActivity {
  id            String      @id @default(cuid())
  sessionId     String
  /// See ACTIVITY_TYPES in lib/exam-activity.ts.
  type          String
  /// Session-order question index (`answer` only).
  questionIndex Int?
  /// The choice picked, -1 = cleared (`answer` only).
  choiceIndex   Int?
  /// The choice before this change, -1 = none (`answer` only).
  previousIndex Int?
  ip            String?
  userAgent     String?
  metadata      Json?
  createdAt     DateTime    @default(now())
  session       ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

/// One row per anti-cheat signal reported by the browser SDK. The server
/// counts rows per (session, type) to decide terminations.
model ExamIntegrityEvent {
  id        String      @id @default(cuid())
  sessionId String
  userId    String
  type      String
  metadata  Json?
  createdAt DateTime    @default(now())
  session   ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, type])
  @@index([sessionId, createdAt])
}
