{
  "name": "codequest-anti-cheat-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:sdk && next dev --port 3001",
    "build": "npm run build:sdk && next build",
    "start": "next start --port 3001",
    "build:sdk": "node scripts/build-sdk.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "lint:check": "eslint . --max-warnings 0",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "jose": "^6.2.2",
    "next": "16.2.4",
    "pg": "^8.20.0",
    "prisma": "^7.7.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.4.7",
    "esbuild": "^0.25.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
